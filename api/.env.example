PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://findr:findr@localhost:5432/findr
JWT_SECRET=dev-only-change-me-findr-jwt-secret
JWT_EXPIRES_IN=7d

# Email (Resend) — password reset + safety alerts
# RESEND_API_KEY=re_...
# EMAIL_FROM=Findr <onboarding@resend.dev>
# SAFETY_ALERT_TO=contactus@myfindr.fun
# PASSWORD_RESET_URL_BASE=https://myfindr.fun/reset-password

# Cloudflare R2 (S3-compatible) — durable media
# S3_BUCKET=findr-media
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Google Sign-In (verify id tokens)
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_ID_ANDROID=

# Admin dashboard https://api.myfindr.fun/admin/
# ADMIN_EMAIL=founder@myfindr.fun
# ADMIN_PASSWORD_BCRYPT=  # node scripts/hash-admin-password.mjs "your-password"
