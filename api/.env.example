PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://findr:findr@localhost:5432/findr
JWT_SECRET=dev-only-change-me-findr-jwt-secret
JWT_EXPIRES_IN=7d

# Email (Resend) — password reset + safety alerts
# RESEND_API_KEY=re_...
# EMAIL_FROM=Findr <onboarding@resend.dev>
# SAFETY_ALERT_TO=contactus@myfindr.fun
# FOUNDER_ALERT_EMAIL=contactus@myfindr.fun
# FOUNDER_EXPO_PUSH_TOKEN=ExponentPushToken[...]  # your phone, for investigation alerts
# ADMIN_PUBLIC_URL=https://api.myfindr.fun/admin/
# PASSWORD_RESET_URL_BASE=https://myfindr.fun/reset-password

# Cloudflare R2 (S3-compatible) — durable media
# S3_BUCKET=findr-media
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Google Sign-In (verify id tokens)
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_ID_ANDROID=

# Admin dashboard https://api.myfindr.fun/admin/
# ADMIN_EMAIL=founder@myfindr.fun
# ADMIN_PASSWORD_BCRYPT=  # node scripts/hash-admin-password.mjs "your-password"

# Push (Expo) — optional; improves deliverability for production push
# EXPO_ACCESS_TOKEN=

# Safety — hide profile from Nearby after this many distinct open reports
# SAFETY_AUTO_HIDE_OPEN_REPORTS=3

# Block NEW email signups only (leave unset for email + Google sign-up)
# DISABLE_EMAIL_SIGNUP=true

# Nearby demo personas when fewer than 4 real profiles match (Play / empty cities)
# INCLUDE_DEMO_NEARBY=false   # turn off in production later
# INCLUDE_DEMO_NEARBY=always  # always show demos (screenshots)
