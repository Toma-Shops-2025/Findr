{
  "expo": {
    "name": "Findr",
    "slug": "findr",
    "version": "0.1.8",
    "icon": "./assets/images/findr-logo.png",
    "scheme": "findr",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.findr.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Findr uses your approximate location to show people nearby. Exact GPS is never shown on your profile.",
        "NSPhotoLibraryUsageDescription": "Findr uses your photo library so you can set a profile picture. Photos upload to Findr only and are not saved back to your gallery."
      }
    },
    "android": {
      "package": "app.findr.mobile",
      "googleServicesFile": "./google-services.json",
      "versionCode": 62,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "com.googleusercontent.apps.155868445533-768bbg1kd7mrtuqlgd7kmbmdji79sr7m",
              "pathPrefix": "/oauth2redirect"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/findr-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "abiFilters": ["arm64-v8a"],
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.hermes.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class expo.modules.** { *; }\n-keep class expo.modules.kotlin.** { *; }\n-keepclassmembers class expo.modules.kotlin.** { *; }\n"
          }
        }
      ],
      "./plugins/withAndroidCiGradle.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/findr-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/findr-logo.png",
          "color": "#FF6B4A"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Findr uses your approximate location to show people nearby. Exact GPS is never shown on your profile.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Findr uses your photo library so you can set a profile picture. Photos upload to Findr only and are not saved back to your gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Findr uses an in-app camera for photos and short videos (max 30 seconds). Media stays in Findr only — not your phone gallery.",
          "microphonePermission": "Findr uses the microphone for short in-app videos (max 30 seconds). Nothing is saved to your phone gallery.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fca40da4-74a0-4eba-83e2-ef6155353a86"
      },
      "apiUrl": "https://api.myfindr.fun",
      "googleWebClientId": "155868445533-ug5fg5r8c79cvc81h9gmdhe81fr0fol1.apps.googleusercontent.com",
      "googleAndroidClientId": "155868445533-768bbg1kd7mrtuqlgd7kmbmdji79sr7m.apps.googleusercontent.com"
    }
  }
}
