{
  "expo": {
    "name": "Findr",
    "slug": "findr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "findr",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.findr.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Findr uses your approximate location to show people nearby. Exact GPS is never shown on your profile.",
        "NSPhotoLibraryUsageDescription": "Findr uses your photo library so you can set a profile picture. Photos upload to Findr only and are not saved back to your gallery."
      }
    },
    "android": {
      "package": "app.findr.mobile",
      "versionCode": 17,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#12151C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12151C"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Findr uses your approximate location to show people nearby. Exact GPS is never shown on your profile.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Findr uses your photo library so you can set a profile picture. Photos upload to Findr only and are not saved back to your gallery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fca40da4-74a0-4eba-83e2-ef6155353a86"
      },
      "apiUrl": "https://api.myfindr.fun"
    },
    "newArchEnabled": false
  }
}