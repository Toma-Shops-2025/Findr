{
  "expo": {
    "name": "Findr",
    "slug": "findr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "findr",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.findr.mobile"
    },
    "android": {
      "package": "app.findr.mobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#12151C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#12151C"
        }
      ],
      "expo-secure-store",
      "./plugins/withDevCleartextTraffic.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Findr lets you pick a photo or short video to send. Media is uploaded to Findr only and is not saved to your phone gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Findr uses an in-app camera. Photos and short videos stay inside Findr -- not your phone gallery.",
          "microphonePermission": "Findr uses the mic for short videos (max 30 seconds) that stay inside Findr.",
          "recordAudioAndroid": true
        }
      ],
      "expo-av",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Findr uses your location to share an approximate pin in chat and for Nearby. Location is not saved to your phone gallery."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fca40da4-74a0-4eba-83e2-ef6155353a86"
      },
      "apiUrl": "https://api.myfindr.fun"
    },
    "newArchEnabled": false
  }
}
