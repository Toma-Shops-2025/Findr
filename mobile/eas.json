{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myfindr.fun"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.myfindr.fun",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "155868445533-ug5fg5r8c79cvc81h9gmdhe81fr0fol1.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
