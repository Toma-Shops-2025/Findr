#!/bin/sh
# Runs mobile OAuth regression tests before push when auth-related files changed.
# Install once: ./scripts/install-git-hooks.sh
# Skip one push: SKIP_OAUTH_HOOK=1 git push   or   git push --no-verify

set -e

if [ -n "$SKIP_OAUTH_HOOK" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
OAUTH_PATTERN='^(mobile/lib/google|mobile/lib/auth\.tsx|mobile/lib/completeGoogleSignIn|mobile/app/oauth|mobile/components/Google)'

needs_oauth_test=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD master 2>/dev/null || true)"
    if [ -n "$base" ]; then
      range="$base..$local_sha"
    else
      range="$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  files="$(git diff --name-only "$range" 2>/dev/null || true)"
  if echo "$files" | grep -qE "$OAUTH_PATTERN"; then
    needs_oauth_test=1
    break
  fi
done

if [ "$needs_oauth_test" = "0" ]; then
  exit 0
fi

echo ""
echo "==> OAuth-related files in this push — running mobile test:oauth..."
echo ""

cd "$ROOT/mobile"
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-push: npm not found; run: cd mobile && npm run test:oauth"
  exit 1
fi

npm run test:oauth

echo ""
echo "==> OAuth pre-push check passed."
echo ""
